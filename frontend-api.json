    "update": {
      "method": "PUT",
      "path": "/api/banners/{id}",
      "description": "Cập nhật banner (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "updateStatus": {
      "method": "PUT",
      "path": "/api/banners/{id}/status",
      "description": "Đổi trạng thái banner (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/banners/{id}",
      "description": "Xóa banner (admin)",
      "authRequired": true,
      "role": "ADMIN"
    }
