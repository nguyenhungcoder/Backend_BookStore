      "authRequired": true,
      "role": "ADMIN"
    }
  },
  "users": {
    "updateProfile": {
      "method": "PUT",
      "path": "/api/users/profile",
      "description": "Cập nhật profile người dùng và lưu danh sách địa chỉ theo chuẩn mới",
      "authRequired": true,
      "requestBody": {
        "fullName": "string",
        "email": "string",
        "phone": "string",
        "addresses": [
          {
            "receiverName": "string",
            "phone": "string",
            "province": "string",
            "district": "string",
            "ward": "string",
            "detailAddress": "string",
            "isDefault": true
          }
        ]
      }
    },
    "adminList": {
      "method": "GET",
      "path": "/api/users",
      "description": "Danh sách người dùng (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "updateStatus": {
      "method": "PUT",
      "path": "/api/users/{id}/status",
      "description": "Cập nhật trạng thái user (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "uploadAvatar": {
      "method": "POST",
      "path": "/api/users/{id}/upload-avatar",
      "description": "Upload avatar (admin)",
      "authRequired": true,
      "role": "ADMIN"
    }
  },
  "vouchers": {
    "list": {
      "method": "GET",
      "path": "/api/vouchers",
      "description": "Danh sách voucher công khai"
    },
    "adminList": {
