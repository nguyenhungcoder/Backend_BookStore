      "authRequired": true,
      "role": "ADMIN"
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/vouchers/{id}",
      "description": "Xóa voucher (admin)",
      "authRequired": true,
      "role": "ADMIN"
    }
  },
  "wishlists": {
    "add": {
      "method": "POST",
      "path": "/api/wishlists",
      "description": "Thêm vào wishlist",
      "authRequired": true
    },
    "remove": {
      "method": "DELETE",
      "path": "/api/wishlists",
