    "updateStatus": {
      "method": "PUT",
      "path": "/api/reviews/{id}/status",
      "description": "Duyệt/tắt đánh giá (admin)",
      "authRequired": true,
      "role": "ADMIN"
    }
  },
  "contacts": {
    "create": {
      "method": "POST",
      "path": "/api/contacts",
      "description": "Gửi liên hệ"
