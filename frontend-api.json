{
  "baseUrl": "http://localhost:8080",
  "auth": {
    "register": {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Đăng ký tài khoản mới"
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Đăng nhập và nhận token"
    }
  },
  "books": {
    "list": {
      "method": "GET",
      "path": "/api/books",
      "description": "Lấy danh sách sách"
    },
    "detail": {
      "method": "GET",
      "path": "/api/books/{id}",
      "description": "Lấy chi tiết sách"
    },
    "create": {
      "method": "POST",
      "path": "/api/books",
      "description": "Tạo sách mới (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "update": {
      "method": "PUT",
      "path": "/api/books/{id}",
      "description": "Cập nhật sách (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "uploadCover": {
      "method": "POST",
      "path": "/api/books/{id}/upload-cover",
      "description": "Upload ảnh bìa sách (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/books/{id}",
      "description": "Xóa sách (admin)",
      "authRequired": true,
      "role": "ADMIN"
    }
  },
  "cart": {
    "add": {
      "method": "POST",
      "path": "/api/cart",
      "description": "Thêm sản phẩm vào giỏ",
      "authRequired": true
    },
    "update": {
      "method": "PUT",
      "path": "/api/cart/{itemId}",
      "description": "Cập nhật số lượng",
      "authRequired": true
    },
    "remove": {
      "method": "DELETE",
      "path": "/api/cart/{itemId}",
      "description": "Xóa item khỏi giỏ",
      "authRequired": true
    }
  },
  "addresses": {
    "list": {
      "method": "GET",
      "path": "/api/addresses",
      "description": "Lấy danh sách địa chỉ",
      "authRequired": true
    },
    "create": {
      "method": "POST",
      "path": "/api/addresses",
      "description": "Thêm địa chỉ",
      "authRequired": true
    },
    "update": {
      "method": "PUT",
      "path": "/api/addresses/{addressId}",
      "description": "Cập nhật địa chỉ",
      "authRequired": true
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/addresses/{addressId}",
      "description": "Xóa địa chỉ",
      "authRequired": true
    }
  },
  "orders": {
    "create": {
      "method": "POST",
      "path": "/api/orders",
      "description": "Tạo đơn hàng",
      "authRequired": true
    },
    "adminList": {
      "method": "GET",
      "path": "/api/orders",
      "description": "Danh sách đơn hàng (admin)",
      "authRequired": true,
      "role": "ADMIN"
    },
    "updateStatus": {
      "method": "PUT",
      "path": "/api/orders/{id}/status",
      "description": "Cập nhật trạng thái đơn hàng (admin)",
      "authRequired": true,
      "role": "ADMIN"
    }
  },
  "payments": {
    "createUrl": {
      "method": "POST",
      "path": "/api/payments/create-url",
      "description": "Tạo link thanh toán",
      "authRequired": true
    },
    "vnpayReturn": {
      "method": "GET",
      "path": "/api/payments/vnpay-return",
      "description": "Callback thanh toán"
    }
  },
  "reviews": {
    "create": {
      "method": "POST",
      "path": "/api/reviews",
      "description": "Tạo đánh giá",
